{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Quan Ly Ho Khau - Nhan Khau Dak Ha",
  "version": "1.0.0",
  "identifier": "com.quanly.hokhau",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5175",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build:vite"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Quản Lý Hộ Khẩu - Nhân Khẩu - Xã Đăk Hà",
        "width": 1366,
        "height": 850,
        "minWidth": 1024,
        "minHeight": 650,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
