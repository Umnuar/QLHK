{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default permissions for QLHK Tauri application",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:app:default",
    "core:webview:default",
    "core:window:default",
    "dialog:default",
    "fs:default",
    "store:default",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://**"
        },
        {
          "url": "http://localhost:**"
        },
        {
          "url": "http://127.0.0.1:**"
        }
      ]
    }
  ]
}
