generator client {
  provider        = "prisma-client-js"
  engineType      = "library"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [pg_trgm, uuid_ossp(map: "uuid-ossp")]
}

model villages {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String             @unique @db.VarChar(255)
  code             String?            @unique @db.VarChar(50)
  created_at       DateTime?          @default(now()) @db.Timestamptz
  updated_at       DateTime?          @default(now()) @updatedAt @db.Timestamptz
  users            users[]
  households       households[]
  audit_logs       audit_logs[]
  chuctho_profiles chuctho_profiles[]
  htxh_profiles    htxh_profiles[]
}

model users {
  id                String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  username          String              @unique @db.VarChar(50)
  password_hash     String              @db.VarChar(255)
  full_name         String?             @db.VarChar(255)
  role              String              @default("user") @db.VarChar(20)
  village_id        String?             @db.Uuid
  module_access     String?             @default("all") @db.VarChar(50)
  created_at        DateTime?           @default(now()) @db.Timestamptz
  updated_at        DateTime?           @default(now()) @updatedAt @db.Timestamptz
  village           villages?           @relation(fields: [village_id], references: [id])
  refresh_tokens    refresh_tokens[]
  audit_logs        audit_logs[]
  profile_audit_log profile_audit_log[]
}

model refresh_tokens {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String    @db.Uuid
  token      String    @unique @db.VarChar(500)
  expires_at DateTime  @db.Timestamptz
  created_at DateTime? @default(now()) @db.Timestamptz
  user       users     @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model households {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  village_id  String     @db.Uuid
  book_number String     @db.VarChar(100)
  address     String?    @db.VarChar(255)
  status      String     @default("active") @db.VarChar(50)
  version     Int        @default(1)
  is_deleted  Boolean    @default(false)
  deleted_at  DateTime?  @db.Timestamptz
  created_at  DateTime?  @default(now()) @db.Timestamptz
  updated_at  DateTime?  @default(now()) @updatedAt @db.Timestamptz
  village     villages   @relation(fields: [village_id], references: [id])
  citizens    citizens[]

  @@index([village_id, is_deleted, created_at(sort: Desc)])
  @@index([village_id, is_deleted, status])
  @@index([book_number])
}

model citizens {
  id              String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  household_id    String     @db.Uuid
  stt             Int?
  is_head         Boolean    @default(false)
  relationship    String?    @db.VarChar(50)
  full_name       String     @db.VarChar(255)
  name_unaccented String?    @db.VarChar(255)
  dob             String?    @db.VarChar(20)
  gender          String?    @db.VarChar(10)
  cccd            String?
  cccd_hash       String?    @db.VarChar(64)
  cccd_last4      String?    @db.VarChar(4)
  ethnicity       String?    @db.VarChar(50)
  religion        String?    @db.VarChar(50)
  education       String?    @db.VarChar(100)
  military_status String?    @db.VarChar(255)
  occupation      String?    @db.VarChar(100)
  native_place    String?    @db.VarChar(255)
  notes           String?
  age75plus         String?    @default("") @db.VarChar(5)
  age70to74poor     String?    @default("") @db.VarChar(5)
  bao_tro           String?    @default("") @db.VarChar(5)
  huu_tri           String?    @default("") @db.VarChar(5)
  huu_tuat_bao_hiem String?    @default("") @db.VarChar(5)
  nguoi_co_cong     String?    @default("") @db.VarChar(5)
  pension_policies  String[]   @default([])
  version         Int        @default(1)
  is_deleted      Boolean    @default(false)
  deleted_at      DateTime?  @db.Timestamptz
  created_at      DateTime?  @default(now()) @db.Timestamptz
  updated_at      DateTime?  @default(now()) @updatedAt @db.Timestamptz
  household       households @relation(fields: [household_id], references: [id], onDelete: Cascade)

  @@index([household_id, is_deleted])
  @@index([is_head, is_deleted])
  @@index([name_unaccented])
  @@index([cccd_hash])
  @@index([cccd_last4])
}

model audit_logs {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  village_id  String?   @db.Uuid
  user_id     String?   @db.Uuid
  action      String    @db.VarChar(50)
  entity_type String    @db.VarChar(50)
  entity_id   String?   @db.VarChar(255)
  old_values  String?
  new_values  String?
  ip_address  String?   @db.VarChar(50)
  created_at  DateTime? @default(now()) @db.Timestamptz
  user        users?    @relation(fields: [user_id], references: [id])
  village     villages? @relation(fields: [village_id], references: [id])

  @@index([village_id, created_at])
  @@index([user_id, created_at])
}

model settings {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key         String    @unique @db.VarChar(100)
  value       String
  description String?
  created_at  DateTime? @default(now()) @db.Timestamptz
  updated_at  DateTime? @default(now()) @updatedAt @db.Timestamptz
}

model chuctho_profiles {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  stt              Int?
  name             String    @db.VarChar(255)
  name_unaccented  String?   @db.VarChar(255)
  dob              String?   @db.VarChar(20)
  gender           String?   @db.VarChar(10)
  cccd             String?
  cccd_hash        String?   @db.VarChar(64)
  cccd_last4       String?   @db.VarChar(4)
  ethnicity        String?   @db.VarChar(50)
  residence        String?
  current_address  String?
  village_id       String?   @db.Uuid
  age60            String?   @default("") @db.VarChar(5)
  age65            String?   @default("") @db.VarChar(5)
  age70            String?   @default("") @db.VarChar(5)
  age75            String?   @default("") @db.VarChar(5)
  age80            String?   @default("") @db.VarChar(5)
  age85            String?   @default("") @db.VarChar(5)
  age90            String?   @default("") @db.VarChar(5)
  age95            String?   @default("") @db.VarChar(5)
  age100           String?   @default("") @db.VarChar(5)
  age_over_100     String?   @default("") @db.VarChar(5)
  received         Boolean?  @default(false)
  calculation_year Int?
  notes            String?   @default("")
  is_deleted       Boolean?  @default(false)
  deleted_at       DateTime? @db.Timestamptz
  created_at       DateTime? @default(now()) @db.Timestamptz
  updated_at       DateTime? @default(now()) @updatedAt @db.Timestamptz
  version          Int?      @default(1)
  village          villages? @relation(fields: [village_id], references: [id])

  @@index([name])
  @@index([village_id])
  @@index([received])
  @@index([is_deleted])
  @@index([cccd_last4])
  @@index([cccd_hash])
  @@index([name_unaccented])
  @@index([village_id, is_deleted, calculation_year])
  @@map("chuctho_profiles")
}

model htxh_profiles {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  village_id        String    @db.Uuid
  stt               Int?
  name              String    @db.VarChar(255)
  name_unaccented   String?   @db.VarChar(255)
  dob               String?   @db.VarChar(20)
  gender            String?   @db.VarChar(10)
  cccd              String?
  cccd_hash         String?   @db.VarChar(64)
  cccd_last4        String?   @db.VarChar(4)
  ethnicity         String?   @db.VarChar(50)
  residence         String?
  current_address   String?
  age75plus         String?   @default("") @db.VarChar(5)
  age70to74poor     String?   @default("") @db.VarChar(5)
  bao_tro           String?   @default("") @db.VarChar(5)
  huu_tri           String?   @default("") @db.VarChar(5)
  huu_tuat_bao_hiem String?   @default("") @db.VarChar(5)
  nguoi_co_cong     String?   @default("") @db.VarChar(5)
  received          Boolean?  @default(false)
  notes             String?   @default("")
  calculation_year  Int?
  is_deleted        Boolean?  @default(false)
  deleted_at        DateTime? @db.Timestamptz
  created_at        DateTime? @default(now()) @db.Timestamptz
  updated_at        DateTime? @default(now()) @updatedAt @db.Timestamptz
  version           Int?      @default(1)
  village           villages  @relation(fields: [village_id], references: [id])

  @@index([name])
  @@index([village_id])
  @@index([received])
  @@index([is_deleted])
  @@index([cccd_last4])
  @@index([cccd_hash])
  @@index([name_unaccented])
  @@index([village_id, is_deleted, calculation_year])
  @@map("htxh_profiles")
}

model profile_audit_log {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profile_id     String    @db.Uuid
  user_id        String?   @db.Uuid
  village_id     String?   @db.Uuid
  action         String    @db.VarChar(20)
  changed_fields Json?
  old_values     Json?
  new_values     Json?
  note           String?
  profile_type   String?   @default("chuctho") @db.VarChar(20)
  sync_source    String?   @default("online") @db.VarChar(20)
  created_at     DateTime? @default(now()) @db.Timestamptz
  user           users?    @relation(fields: [user_id], references: [id])

  @@index([profile_id])
  @@index([village_id])
  @@index([created_at])
  @@index([village_id, created_at(sort: Desc)])
  @@map("profile_audit_log")
}
