{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Quan Ly Ho Khau - Nhan Khau Dak Ha",
  "version": "1.5.0",
  "identifier": "com.quanly.hokhau",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5175",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build:vite"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Quản Lý Hộ Khẩu & Chính Sách Xã Hội - Xã Đăk Hà",
        "width": 1366,
        "height": 850,
        "minWidth": 1024,
        "minHeight": 650,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "http://localhost:5002/api/updates/latest"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU3RUNGNTkyQkM1MTNDNjkKUldScFBGRzhrdlhzVjY0eHJFUnhRNEpLbXNCZlJKa2NVRm9Nc2dzWUV1N3ZrNk5HZkw2SUFmNUIK"
    }
  }
}
